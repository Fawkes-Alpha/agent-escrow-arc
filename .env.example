# Sao chep file nay thanh .env roi dien gia tri that.
# KHONG BAO GIO commit file .env that.
#
# RPC_PROXY_TOKEN la chia khoa gan voi tai khoan Arc Studio cua ban.
# Tai du an tu Arc Studio ve thi file .env da co san cac gia tri nay.

RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=

# Khong bat buoc: tro thang vao RPC cong khai cua Arc mainnet,
# khong can proxy cua Arc Studio.
# VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
